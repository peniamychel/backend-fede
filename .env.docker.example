# Copiar como .env.docker. Este archivo de ejemplo sí entra en Git; la copia
# con contraseñas queda excluida.

# El frontend vive actualmente fuera del directorio del backend.
FRONTEND_CONTEXT=C:/Users/Usuario/AndroidStudioProjects/frontend-fede
WEB_PUERTO=80

# Base exclusiva del entorno Docker. No usa la MariaDB de desarrollo.
DB_NOMBRE=federa
DB_USUARIO=federa
DB_CONTRASENA=cambiar_por_una_contrasena_larga
DB_ROOT_CONTRASENA=cambiar_por_otra_contrasena_larga

# Debe mantenerse estable entre reinicios. Base64 de al menos 32 bytes.
JWT_CLAVE=generar_una_clave_base64_segura
ADMIN_USUARIO=admin
ADMIN_CONTRASENA=cambiar_la_contrasena_inicial
EXIGIR_AUTENTICACION=false

# SIE es el único servicio que necesita salida a Internet.
SIE_HABILITADO=true
SIE_URL=https://api.itt.sie.gob.bo/persona/busqueda
SIE_TOKEN=

BACKUP_HABILITADO=true
BACKUP_AUTOMATICO=true

PIE_FIRMA_SINDICATO_HABILITADO=false
FIRMA_SINDICATO_OBLIGATORIA=false
