# Copiar este archivo como .env y reemplazar los valores.
# No usar comillas: Spring lee este archivo con formato .properties.

# MariaDB
DB_URL=jdbc:mariadb://localhost:3307/federa?createDatabaseIfNotExist=true&sslMode=disable&sessionVariables=character_set_server=utf8mb4,collation_server=utf8mb4_unicode_ci
DB_USUARIO=usuario_mariadb
DB_CONTRASENA=contrasena_mariadb

# Consulta de identidad SIE
SIE_HABILITADO=true
SIE_URL=https://api.itt.sie.gob.bo/persona/busqueda
SIE_TOKEN=token_bearer_vigente

# Seguridad de la aplicacion (opcionales mientras la autenticacion no se exija)
JWT_CLAVE=
ADMIN_USUARIO=admin
ADMIN_CONTRASENA=cambiar_esta_contrasena

# Directorio. Por defecto el sindicato muestra el pie de firma como opción
# deshabilitada y su firma manuscrita no bloquea las credenciales.
PIE_FIRMA_SINDICATO_HABILITADO=false
FIRMA_SINDICATO_OBLIGATORIA=false
